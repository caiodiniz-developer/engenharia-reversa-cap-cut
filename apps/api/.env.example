# Copie para apps/api/.env (não é versionado). Todas as variáveis têm padrão para desenvolvimento.

# Banco. Se omitido em desenvolvimento, `pnpm dev:api` sobe um PostgreSQL embarcado.
# DATABASE_URL=postgresql://editor:editor@localhost:5432/editor?schema=public

# OBRIGATÓRIO em produção (mínimo 32 caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=
# URL_SIGNING_SECRET=            # opcional; padrão = JWT_SECRET

PORT=3001
CORS_ORIGINS=http://localhost:5173
# URL pública usada nos links assinados de mídia/download. Em dev aponta para o Vite (proxy, mesma origem).
PUBLIC_API_URL=http://localhost:5173

# Armazenamento e limites
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=2147483648
MAX_MEDIA_SECONDS=7200
MAX_PROJECT_MEDIA=200
EXPORT_CONCURRENCY=1
PROCESSING_CONCURRENCY=2
EXPORT_RETENTION_HOURS=24
EXPORT_TIMEOUT_SECONDS=3600
SIGNED_URL_TTL_SECONDS=3600

# IA — as chaves ficam SOMENTE no servidor. Nada é simulado: sem provedor a API responde 503.
# Transcrição local (whisper.cpp): os dados não saem do servidor.
# WHISPER_BIN=/usr/local/bin/whisper-cli
# WHISPER_MODEL=/models/ggml-base.bin
# Transcrição por API (o áudio é enviado ao provedor):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# Assistente de edição / resumo / títulos (LLM):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_CALL_LIMIT=50

# Binários alternativos (padrão: ffmpeg-static / ffprobe-static)
# FFMPEG_PATH=
# FFPROBE_PATH=

# Windows com pouco espaço no disco do sistema: aponte dados e temporários para outro disco.
# PGDATA_DIR=D:/editor-data/pg
# TEMP_DIR=D:/editor-data/tmp
