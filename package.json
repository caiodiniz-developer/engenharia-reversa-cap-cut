{
  "name": "web-video-editor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:api": "pnpm --filter @editor/api dev:all",
    "dev:web": "pnpm --filter @editor/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "e2e": "pnpm --filter @editor/web e2e",
    "e2e:prod": "pnpm --filter @editor/web e2e:prod"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "@types/node": "22.10.2",
    "tsx": "4.19.2"
  }
}
